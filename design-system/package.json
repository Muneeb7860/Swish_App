{
	"name": "@swish/design-system",
	"version": "1.0.0",
	"description": "Unified design system for Swish platform — consolidated components, tokens, and design patterns",
	"private": false,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./tokens": {
			"import": "./dist/tokens.css"
		},
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"import": "./dist/components/*.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:types": "tsc",
		"preview": "vite preview",
		"lint": "eslint .",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@swish/shared-ui": "file:../shared-ui",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.5.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^3.0.0",
		"eslint": "^10.3.0",
		"jsdom": "^25.0.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.12",
		"vitest": "^3.0.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"keywords": [
		"design-system",
		"components",
		"tokens",
		"swish",
		"react"
	],
	"author": "Swish Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/swish/swish-app.git",
		"directory": "design-system"
	}
}

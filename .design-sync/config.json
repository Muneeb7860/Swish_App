{
  "shape": "package",
  "pkg": "frontend-b2b",
  "globalName": "SwishB2B",
  "buildCmd": "cd frontend-b2b && npm run build && cp dist/assets/style-*.css .ds-compiled.css",
  "srcDir": "src",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".ds-compiled.css",
  "tokensGlob": "../shared-ui/src/tokens.css",
  "readmeHeader": ".design-sync/conventions.md",
  "componentSrcMap": {
    "CheckoutPanel": "src/components/CheckoutPanel.tsx",
    "ConnectionConfig": "src/components/ConnectionConfig.tsx",
    "CreditCardMockup": "src/components/CreditCardMockup.tsx",
    "NotificationInbox": "src/components/NotificationInbox.tsx",
    "OrderTimeline": "src/components/OrderTimeline.tsx",
    "RetailerOnboarding": "src/components/RetailerOnboarding.tsx",
    "SandboxLogs": "src/components/SandboxLogs.tsx",
    "SensorProvisioning": "src/components/SensorProvisioning.tsx",
    "StatusIndicator": "src/components/StatusIndicator.tsx"
  },
  "extraEntries": [
    "./.ds-provider.tsx"
  ],
  "provider": {
    "component": "B2bSurface"
  }
}

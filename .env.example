# ==============================================================================
# SWISH QUICK COMMERCE - LOCAL ENVIRONMENT TEMPLATE (.env)
# ==============================================================================
# Copy this file to '.env' in the project root to override database passwords,
# custom API keys, and CORS settings for your local cluster.
# DO NOT COMMIT THE COMPLETED '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ─── DATABASE CONFIGURATION ───────────────────────────────────────────────────
POSTGRES_DB=swiss_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=swisssecure2026

# ─── SECURITY CONFIGURATION ───────────────────────────────────────────────────
# Must be a cryptographically strong HS256 key (minimum 32 characters/256 bits)
JWT_SECRET=my-secret-key-that-is-long-enough-to-be-secure-for-jwt-signature-verification-32bytes-long

# ─── GATEWAY CORS ALLOWED ORIGINS ─────────────────────────────────────────────
# Comma-separated list of origins permitted to request APIs through the Edge BFF
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ─── AI ORCHESTRATION CONFIGURATION ───────────────────────────────────────────
# If using Gemini OpenAI endpoints via Spring AI
SPRING_AI_OPENAI_API_KEY=mock-key
SPRING_AI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# If using local Ollama model cluster
SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434

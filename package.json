{
	"name": "swish-app",
	"version": "1.0.0",
	"description": "Enterprise Quick Commerce Platform - 15-Minute Grocery Delivery Microservices Cluster",
	"keywords": [
		"quick-commerce",
		"q-commerce",
		"grocery-delivery",
		"microservices",
		"event-driven",
		"spring-boot",
		"react",
		"kafka",
		"redis",
		"hexagonal-architecture"
	],
	"author": "Muneeb7860",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Muneeb7860/Swish_App.git"
	},
	"bugs": {
		"url": "https://github.com/Muneeb7860/Swish_App/issues"
	},
	"scripts": {
		"dev:host": "cd frontend-host && npm run dev",
		"dev:customer": "cd frontend-customer && npm run dev",
		"dev:rider": "cd frontend-rider && npm run dev",
		"dev:admin": "cd frontend-admin && npm run dev",
		"build:all": "npm run build --prefix frontend-host && npm run build --prefix frontend-customer && npm run build --prefix frontend-rider && npm run build --prefix frontend-admin",
		"format": "biome format --write ./"
	},
	"dependencies": {
		"@vitejs/plugin-react": "^6.0.2",
		"lucide-react": "^1.17.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"vite": "^8.0.16"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16"
	}
}

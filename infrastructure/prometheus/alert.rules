groups:
- name: swish_app_alerts
  rules:
  - alert: HighApiLatency
    expr: http_server_requests_seconds_sum / http_server_requests_seconds_count > 0.5
    for: 1m
    labels:
      severity: warning
    annotations:
      summary: "High API Latency on {{ $labels.instance }}"
      description: "The API latency is above 500ms for more than 1 minute."

  - alert: KafkaDlqSpike
    expr: rate(kafka_producer_record_error_total[1m]) > 0
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: "Kafka DLQ Spiking on {{ $labels.instance }}"
      description: "Errors producing to Kafka are detected, likely messages are hitting the DLQ."

  - alert: HighErrorRate
    expr: rate(http_server_requests_seconds_count{status=~"5.."}[1m]) > 5
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: "High 5xx Error Rate on {{ $labels.instance }}"
      description: "More than 5 HTTP 5xx errors per minute detected."

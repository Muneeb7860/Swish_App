      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"backend\",uri=~\"/api/customer/orders.*\",method=\"POST\",status=~\"2..\"}[1m]))",
          "legendFormat": "orders placed/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"backend\",uri=~\"/api/payments.*\",method=\"POST\",status=~\"2..\"}[1m]))",
          "legendFormat": "payments/s",
          "refId": "B"

    {
      "id": 41,
      "type": "timeseries",
      "title": "Order Endpoint Activity",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "swish-prometheus"
      },

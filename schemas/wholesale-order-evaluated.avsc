{
  "type": "record",
  "name": "WholesaleOrderEvaluated",
  "namespace": "com.platform.schemas.b2b",
  "doc": "Event published by the Python LangGraph module (Dell Edge) after evaluating credit risk.",
  "fields": [
    { "name": "order_id", "type": "string", "doc": "Unique UUID of the evaluated order" },
    { 
      "name": "status", 
      "type": {
        "type": "enum",
        "name": "EvaluationStatus",
        "symbols": ["APPROVED", "REJECTED", "HUMAN_TRIAGE"]
      },
      "doc": "Final routing decision made by the AI Agent" 
    },
    { "name": "credit_limit_remaining", "type": "double", "doc": "Remaining Net-30 credit limit after evaluation" },
    { "name": "ai_reasoning", "type": "string", "doc": "The reasoning text generated by the LLM for audit logs" },
    { "name": "evaluated_at", "type": "long", "logicalType": "timestamp-millis", "doc": "Epoch milliseconds" }
  ]
}
